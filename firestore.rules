rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /tasks/{taskId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200;
      }

      // العادات: users/{uid}/habits/{id}
      match /habits/{habitId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120;
      }

      // الفلوس: users/{uid}/transactions/{id}
      match /transactions/{txId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.type in ['expense', 'income'];
      }

      // إعدادات الفلوس (الميزانية والأهداف): users/{uid}/money/settings
      match /money/{docId} {
        allow read, write: if isOwner(uid);
      }

      // اليوميات: users/{uid}/journal/{yyyy-MM-dd}
      match /journal/{day} {
        allow read, write: if isOwner(uid);
      }

      // المناسبات وصلة الرحم: users/{uid}/family/{occasions|people}
      match /family/{docId} {
        allow read, write: if isOwner(uid);
      }

      // رمضان: users/{uid}/ramadan/{hijriYear}
      match /ramadan/{year} {
        allow read, write: if isOwner(uid);
      }

      // السبحة: users/{uid}/tasbeeh/{yyyy-MM-dd}
      match /tasbeeh/{day} {
        allow read, write: if isOwner(uid);
      }

      // محادثة المساعد المحفوظة: users/{uid}/assistant/chat
      match /assistant/{docId} {
        allow read, write: if isOwner(uid);
      }

      // قضاء الصلوات: users/{uid}/qada/state
      match /qada/{docId} {
        allow read, write: if isOwner(uid);
      }

      // أهدافي: users/{uid}/goals/state
      match /goals/{docId} {
        allow read, write: if isOwner(uid);
      }

      // وضع التركيز: users/{uid}/focus/{yyyy-MM-dd}
      match /focus/{day} {
        allow read, write: if isOwner(uid);
      }

      // سجل الصلوات: users/{uid}/prayers/{yyyy-MM-dd}
      match /prayers/{day} {
        allow read, write: if isOwner(uid);
      }

      // تقدّم القرآن: users/{uid}/quran/progress
      match /quran/{docId} {
        allow read, write: if isOwner(uid);
      }

      // عدّاد استخدام المساعد: السيرفر بس اللي يكتب فيه
      match /usage/{day} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }
  }
}
